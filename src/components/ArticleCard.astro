---
import type { CollectionEntry } from "astro:content";

import { formatDate } from "../utils";
import Tags from "./Tags.astro";
import type { string } from "astro:schema";

const { article } = Astro.props;

interface Props {
  article: CollectionEntry<"blog">;
}
---

<article
  class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-0 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl dark:hover:shadow-gray-900/50 transition-all duration-300 flex flex-col group"
>
  <div class="w-full h-48 overflow-hidden bg-gray-100 dark:bg-gray-800">
    <a
      href={`/articles/${article.id}`}
      class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 inline-flex items-center gap-1"
    >
      <img
        src={article.data.image}
        alt={article.data.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </a>
  </div>
  <div class="p-6 grow flex flex-col">
    <div class="flex justify-between items-center mb-2">
      <Tags tags={article.data.tags} />

      <span class="text-xs text-gray-400 dark:text-gray-500">
        {formatDate(article.data.pubDate)}
      </span>
    </div>
    <span
      class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors"
    >
      {article.data.title}
    </span>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">
      By {article.data.author}
    </p>
    {
      /* <div class="h-5 w-5 bg-indigo-500 my-1">
              {article.data.tags.map((tag,index)=>(

              ))}
            </div> */
    }
    <a
      href={`/articles/${article.id}`}
      class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 inline-flex items-center gap-1 mt-auto pt-2 transition-colors"
    >
      Read Article &rarr;
    </a>
  </div>
</article>
