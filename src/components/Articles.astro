---
import ArticleCard from "./ArticleCard.astro";
import SearchArticle from "./SearchArticle.astro";
import type { CollectionEntry } from "astro:content";

import BackToHome from "../components/BackToHome.astro";

// 1. Define the Props interface
interface Props {
  articles: CollectionEntry<"blog">[];
}

// 2. Destructure articles from Astro.props
const { articles } = Astro.props;
---

<section class="max-w-screen mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <BackToHome />

  <SearchArticle />
  <br />
  <div class="mb-12">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-4 dark:text-white">All Articles</h1>
    <p class="text-gray-600 dark:text-white">
      Explore our complete collection of technical guides, hardware specs, and
      software tutorials.
    </p>
  </div>

  <div class="grid md:grid-cols-3 gap-8">
    {articles.map((article) => <ArticleCard article={article} />)}
  </div>
</section>
