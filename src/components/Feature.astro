---
const features = [
  {
    title: "Server-Side Rendering (SSR)",
    description:
      "Blazing fast dynamic pages powered by Astro SSR engine with minimal client JavaScript.",
    icon: "⚡",
  },
  {
    title: "Hardware Breakdowns",
    description:
      "Detailed schematics and analyses of micro-controllers, electrical boards, and systems.",
    icon: "⚙️",
  },
  {
    title: "Markdown & MDX Support",
    description:
      "Write content seamlessly using structured Markdown or interactive MDX components.",
    icon: "📝",
  },
  {
    title: "Optimized Image Pipeline",
    description:
      "Automatic image formatting and asset serving directly from the public asset directory.",
    icon: "🖼️",
  },
];
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="text-center max-w-3xl mx-auto mb-16">
    <h1 class="text-4xl font-extrabold dark:text-gray-100 text-gray-900 mb-4">
      Platform Features
    </h1>
    <p class="text-lg dark:text-gray-100 text-gray-600">
      Everything designed to deliver top-tier technical content and
      lightning-fast user experience.
    </p>
  </div>

  <!-- Feature Grid -->
  <div class="grid md:grid-cols-2 gap-8">
    {
      features.map((feature) => (
        <div
  class="feature-card group relative p-8 rounded-2xl transition-all duration-200 ease-out overflow-hidden backdrop-blur-xl transform-gpu
    /* Light Mode: Frosted Glass / Light Metallic */
    bg-white/60 dark:bg-slate-800/40
    border border-slate-200/80 dark:border-slate-700/50
    shadow-sm hover:shadow-xl hover:shadow-slate-500/10"
  style="transform-style: preserve-3d; perspective: 1000px;"
>
  <!-- Windows 10 Style Rectangular Border & Surface Sheen -->
  <div
    class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl z-0"
    style="
      background: 
        linear-gradient(
          to right, 
          transparent, 
          rgba(255, 255, 255, 0.05) calc(var(--x, 50%) - 20px), 
          rgba(255, 255, 255, 0.15) var(--x, 50%), 
          rgba(255, 255, 255, 0.05) calc(var(--x, 50%) + 20px), 
          transparent
        ),
        linear-gradient(
          to bottom, 
          transparent, 
          rgba(255, 255, 255, 0.05) calc(var(--y, 50%) - 20px), 
          rgba(255, 255, 255, 0.15) var(--y, 50%), 
          rgba(255, 255, 255, 0.05) calc(var(--y, 50%) + 20px), 
          transparent
        );
      mix-blend-mode: overlay;
    "
  ></div>

  <!-- Content Container (Elevated on Z-Axis for 3D Pop) -->
  <div class="relative z-10 transition-transform duration-200 ease-out" style="transform: translateZ(20px);">
    <div class="text-4xl mb-4 drop-shadow-sm">{feature.icon}</div>
    <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100 mb-2 tracking-tight">
      {feature.title}
    </h2>
    <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-sm">
      {feature.description}
    </p>
  </div>
</div>

<!-- 3D Tilt + Cursor Tracking Script -->
<script>
  const cards = document.querySelectorAll<HTMLElement>('.feature-card');

  cards.forEach((card) => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      // Update Cursor Position for Sheen Effect
      card.style.setProperty('--x', `${x}px`);
      card.style.setProperty('--y', `${y}px`);

      // Calculate 3D Tilt Angle (Max 8 degrees tilt)
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -8;
      const rotateY = ((x - centerX) / centerX) * 8;

      card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
    });

    card.addEventListener('mouseleave', () => {
      // Reset tilt and sheen on exit
      card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
    });
  });
</script>
      ))
    }
  </div>
</section>
