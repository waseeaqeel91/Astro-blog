---
import { fontData } from "astro:assets";
import { formatDate } from "../../src/utils.ts";

import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
const { article } = Astro.props;

interface Props {
  article: CollectionEntry<"blog">;
}
---

<div
  class="w-full relative group rounded-2xl overflow-hidden shadow-2xl border dark:border-zinc-800 border-gray-200/80 bg-gray-900"
>
  <!-- HERO DISPLAY IMAGE -->
  <img
    src={article.data.image}
    alt="TechPeople Interface Preview"
    class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-500 ease-out"
  />

  <!-- VINTAGE INTERACTIVE OVERLAY -->
  <div
    class="absolute inset-0 bg-amber-950/30 backdrop-sepia-[0.35] backdrop-contrast-125 mix-blend-multiply opacity-80 group-hover:opacity-40 transition-opacity duration-500 pointer-events-none"
  >
  </div>

  <!-- GRADIENT MASK FOR TEXT READABILITY -->
  <div
    class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-6 sm:p-8 text-white transition-all duration-300"
  >
    <span
      class="text-xs uppercase tracking-widest text-amber-300 font-mono mb-1"
    >
      Feature Spec
    </span>
    <h3 class="text-xl font-bold mb-2 text-white drop-shadow-sm">
      {article.data.title}
    </h3>
    <p
      class="text-xs sm:text-sm text-gray-200 dark:text-gray-300 mb-4 max-w-sm line-clamp-2"
    >
      Explore dynamic benchmarks, firmware configurations, and custom system
      setups.
    </p>

    <div class="flex items-center justify-between">
      <a
        href={`/articles/${article.id}`}
        class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-gray-900 bg-amber-400 hover:bg-amber-300 rounded-lg shadow-md transition-all duration-200 transform group-hover:translate-x-1"
      >
        <span>Explore Spec</span>
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </a>

      <div class="">
        <span class="text-amber-300/90 text-[13px] font-bold"
          >{formatDate(article.data.pubDate)}</span
        >
      </div>
    </div>
  </div>
</div>
