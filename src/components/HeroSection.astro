---
import SearchArticle from "./SearchArticle.astro";
import type { CollectionKey } from "astro:content";

import { HOMEPAGE_ARTICLE_LIMIT } from "./../constant.ts";
import ArticleCard from "./ArticleCard.astro";
import HeroSecImage from "./HeroSecImage.astro";

import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
const articles = (await getCollection("blog")).sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const mostRecentArticles: CollectionEntry<"blog"> = articles[0];
const otherArticles: CollectionEntry<"blog">[] = articles.slice(1);
---

<main class="flex-grow">
  <!-- HERO SECTION -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <span
          class="inline-flex items-center gap-2 px-3 py-1 text-xs font-semibold text-indigo-700 bg-indigo-50 border border-indigo-100 rounded-full mb-6"
        >
          <span class="w-2 h-2 rounded-full bg-indigo-600 animate-pulse"></span>
          Astro SSR & Tech Knowledge Base
        </span>
        <h1
          class="text-4xl sm:text-5xl font-extrabold text-gray-900 leading-tight tracking-tight mb-6"
        >
          Articles, Stories & <br class="hidden sm:inline" />
          <span class="text-indigo-600">Tutorials for Tech People.</span>
        </h1>
        <p class="text-lg text-gray-600 mb-8 max-w-lg leading-relaxed">
          Explore deep technical insights, modern web hardware breakdowns, drone
          engineering, and software workflows.
        </p>

        <!-- SEARCH FORM & ACTION BUTTON -->
        <!-- SEARCH FORM & ACTION BUTTONS -->
        <div
          class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 max-w-xl"
        >
          <!-- SEARCH BAR -->
          <div class="flex-grow">
            <SearchArticle />
          </div>
        </div>
      </div>

      <!-- HERO DISPLAY IMAGE -->
      <HeroSecImage article={mostRecentArticles} />
    </div>

    <!-- FEATURED COLLECTIONS GRID -->
    <section class="bg-gray-50/80 border-y border-gray-200/80 py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">
            Featured Content & Tech Specs
          </h2>
          <p class="text-gray-600">
            Handcrafted articles and hardware breakdowns optimized for
            developers and creators.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 mb-12">
          <!-- CARDS -->
          {
            otherArticles
              .slice(0, HOMEPAGE_ARTICLE_LIMIT)
              .map((article) => <ArticleCard article={article} />)
          }
        </div>

        <!-- SECONDARY BROWSE ALL BUTTON AT THE BOTTOM OF FEATURED SECTION -->
        <div class="text-center">
          <a
            href="/articles"
            class="inline-flex items-center gap-2 px-8 py-3.5 border border-indigo-600 text-indigo-600 hover:bg-indigo-600 hover:text-white font-semibold rounded-xl transition-all shadow-sm"
          >
            View All {articles.length} Articles
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- OUR TEAM SECTION -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Meet the Writers</h2>
        <p class="text-gray-600">
          Engineers, designers, and content creators contributing to the
          TechPeople platform.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- TEAM MEMBER 1 -->
        <div class="text-center group">
          <div
            class="w-32 h-32 mx-auto mb-4 rounded-full overflow-hidden border-2 border-indigo-100 shadow-md group-hover:border-indigo-600 transition-colors"
          >
            <img
              src="src/images/team1.png"
              alt="Alex Morgan"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <h3 class="text-lg font-bold text-gray-900">Alex Morgan</h3>
          <p class="text-sm text-indigo-600 font-medium">
            Lead Systems Architect
          </p>
        </div>

        <!-- TEAM MEMBER 2 -->
        <div class="text-center group">
          <div
            class="w-32 h-32 mx-auto mb-4 rounded-full overflow-hidden border-2 border-indigo-100 shadow-md group-hover:border-indigo-600 transition-colors"
          >
            <img
              src="src/images/team2.png"
              alt="Julian Vance"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <h3 class="text-lg font-bold text-gray-900">Julian Vance</h3>
          <p class="text-sm text-indigo-600 font-medium">Hardware Reviewer</p>
        </div>

        <!-- TEAM MEMBER 3 -->
        <div class="text-center group">
          <div
            class="w-32 h-32 mx-auto mb-4 rounded-full overflow-hidden border-2 border-indigo-100 shadow-md group-hover:border-indigo-600 transition-colors"
          >
            <img
              src="src/images/team3.png"
              alt="Elena Rostova"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <h3 class="text-lg font-bold text-gray-900">Elena Rostova</h3>
          <p class="text-sm text-indigo-600 font-medium">UX Research Lead</p>
        </div>
      </div>
    </section>
  </section>
</main>
