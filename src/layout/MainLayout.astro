---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { capitalize } from "../utils";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";

const allBlogArticles: CollectionEntry<"blog">[] = await getCollection("blog");

const tags: string[] = allBlogArticles.flatMap(
  (article: any) => article.data.tags,
);

const uniqueTags: string[] = [...new Set(tags)];
---

<Analytics />
<ClientRouter />

<header
  transition:persist
  class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-200"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between"
  >
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div
        class="w-10 h-10 bg-indigo-50 border border-indigo-100 rounded-xl flex items-center justify-center group-hover:bg-indigo-100 transition-colors"
      >
        <img
          src="/images/image1.png"
          alt="TechPeople Logo"
          class="w-full h-full object-cover rounded-xl"
        />
      </div>
      <span class="text-xl font-bold tracking-tight text-gray-900">
        TechPeople<span class="text-indigo-600">.</span>
      </span>
    </a>

    <!-- Navigation Links -->
    <nav
      id="main-nav"
      class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-600"
    >
      <a
        href="/"
        class={Astro.url.pathname === "/"
          ? "text-indigo-600 font-semibold nav-link"
          : "hover:text-indigo-600 transition-colors nav-link"}>Home</a
      >
      <a
        href="/articles"
        class={Astro.url.pathname.startsWith("/articles")
          ? "text-indigo-600 font-semibold nav-link"
          : "hover:text-indigo-600 transition-colors nav-link"}>Articles</a
      >
      <a
        href="/features"
        class={Astro.url.pathname.startsWith("/features")
          ? "text-indigo-600 font-semibold nav-link"
          : "hover:text-indigo-600 transition-colors nav-link"}>Features</a
      >
      <a
        href="/about"
        class={Astro.url.pathname.startsWith("/about")
          ? "text-indigo-600 font-semibold nav-link"
          : "hover:text-indigo-600 transition-colors nav-link"}>About</a
      >
    </nav>

    <!-- Action Buttons -->
    <div class="flex items-center gap-3">
      <a
        href="#"
        class="text-sm font-semibold text-gray-700 hover:text-indigo-600 px-3 py-2 transition-colors"
      >
        Sign In
      </a>
      <a
        href="#"
        class="text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 px-4 py-2 rounded-xl transition-all shadow-sm hover:shadow-indigo-200"
      >
        Get Started
      </a>
    </div>
  </div>
</header>

<main class="max-h-full" transition:animate="fade">
  <slot />
</main>

<footer class="bg-gray-900 text-gray-400 border-t border-gray-800 py-12">
  <div
    class="max-w-7xl mx-auto flex justify-between px-4 sm:px-6 lg:px-8 mb-12"
  >
    <div class="flex flex-col flex-nowrap">
      <h4 class="text-white font-semibold f gap-8 text-sm mb-4">Resources</h4>
      <ul
        class="space-y-2.5 text-sm bg-amber-200/0 flex flex-wrap justify-between max-h-[300px] max-w-[300px] gap-3"
      >
        {
          uniqueTags.map((tag) => (
            <li class="flex w-17">
              <a
                href={"/articles/tag/" + tag}
                class="hover:text-white transition-colors"
              >
                #{capitalize(tag)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex w-1/2 justify-between">
      <div>
        <h4 class="text-white font-semibold text-sm mb-4">Navigation</h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/" class="hover:text-white transition-colors">Home</a>
          </li>
          <li>
            <a href="/articles" class="hover:text-white transition-colors"
              >Articles</a
            >
          </li>
          <li>
            <a href="/about" class="hover:text-white transition-colors"
              >About Us</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h4 class="text-white font-semibold text-sm mb-4">Community</h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="#" class="hover:text-white transition-colors">GitHub</a>
          </li>
          <li>
            <a href="#" class="hover:text-white transition-colors">Discord</a>
          </li>
          <li>
            <a href="#" class="hover:text-white transition-colors">Twitter</a>
          </li>
        </ul>
      </div>
      <div>
        <h4 class="text-white font-semibold text-sm mb-4">Legal</h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="#" class="hover:text-white transition-colors"
              >Privacy Policy</a
            >
          </li>
          <li>
            <a href="#" class="hover:text-white transition-colors"
              >Terms of Service</a
            >
          </li>
        </ul>
      </div>
    </div>
  </div>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 border-t border-gray-800 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 gap-4"
  >
    <p>© 2026 TechPeople. All rights reserved.</p>
    <p>Built with Astro & Tailwind CSS.</p>
  </div>
</footer>

<script>
  // Dynamic active link highlighting for transition:persist navigation
  document.addEventListener("astro:page-load", () => {
    const pathname = window.location.pathname;
    const navLinks = document.querySelectorAll("#main-nav a.nav-link");

    navLinks.forEach((link) => {
      const href = link.getAttribute("href");
      const isActive =
        href === "/" ? pathname === "/" : href && pathname.startsWith(href);

      if (isActive) {
        link.className = "text-indigo-600 font-semibold nav-link";
      } else {
        link.className = "hover:text-indigo-600 transition-colors nav-link";
      }
    });
  });
</script>

<style is:global>
  /* Slow down the view transition swap so content has time to render */
  ::view-transition-old(root) {
    animation-duration: 400ms;
  }
  ::view-transition-new(root) {
    animation-duration: 500ms;
    animation-delay: 200ms;
  }
</style>
