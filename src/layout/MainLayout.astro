---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { capitalize } from "../utils";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";

const allBlogArticles: CollectionEntry<"blog">[] = await getCollection("blog");

const tags: string[] = allBlogArticles.flatMap(
  (article: any) => article.data.tags,
);

const uniqueTags: string[] = [...new Set(tags)];
---

<Analytics />
<ClientRouter />

<script is:inline>
  // Inline theme initialization to prevent theme flash on load
  const setInitialTheme = () => {
    const storedTheme = localStorage.getItem("theme");
    if (
      storedTheme === "dark" ||
      (!storedTheme &&
        window.matchMedia("(prefers-color-scheme: dark)").matches)
    ) {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
  };
  setInitialTheme();
  document.addEventListener("astro:after-swap", setInitialTheme);
</script>

<header
  transition:persist
  class="sticky top-0 z-40 bg-white/90 dark:bg-gray-900/90 backdrop-blur-md border-b border-gray-200 dark:border-gray-800 transition-colors"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4"
  >
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group shrink-0">
      <div
        class="w-10 h-10 bg-indigo-50 dark:bg-indigo-950/50 border border-indigo-100 dark:border-indigo-900/50 rounded-xl flex items-center justify-center group-hover:bg-indigo-100 dark:group-hover:bg-indigo-900 transition-colors"
      >
        <img
          src="/images/image1.png"
          alt="TechPeople Logo"
          class="w-full h-full object-cover rounded-xl"
        />
      </div>
      <span
        class="text-xl font-bold tracking-tight text-gray-900 dark:text-white"
      >
        TechPeople<span class="text-indigo-600 dark:text-indigo-400">.</span>
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav
      id="main-nav"
      class="hidden lg:flex items-center gap-8 text-sm font-medium text-gray-600 dark:text-gray-300"
    >
      <a
        href="/"
        class={Astro.url.pathname === "/"
          ? "text-indigo-600 dark:text-indigo-400 font-semibold nav-link"
          : "hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors nav-link"}
        >Home</a
      >
      <a
        href="/articles"
        class={Astro.url.pathname.startsWith("/articles")
          ? "text-indigo-600 dark:text-indigo-400 font-semibold nav-link"
          : "hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors nav-link"}
        >Articles</a
      >
      <a
        href="/features"
        class={Astro.url.pathname.startsWith("/features")
          ? "text-indigo-600 dark:text-indigo-400 font-semibold nav-link"
          : "hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors nav-link"}
        >Features</a
      >
      <a
        href="/about"
        class={Astro.url.pathname.startsWith("/about")
          ? "text-indigo-600 dark:text-indigo-400 font-semibold nav-link"
          : "hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors nav-link"}
        >About</a
      >
    </nav>

    <!-- Header Actions & Theme Switcher -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Dark / Light Theme Toggle Button -->
      <button
        type="button"
        class="theme-toggle p-2 text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-colors focus:outline-none"
        aria-label="Toggle Theme"
      >
        <svg
          class="w-5 h-5 hidden dark:block"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <svg
          class="w-5 h-5 block dark:hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>

      <!-- Auth Triggers -->
      <button
        type="button"
        data-modal-target="signin-modal"
        class="hidden sm:inline-block text-sm font-semibold text-gray-700 dark:text-gray-200 hover:text-indigo-600 dark:hover:text-indigo-400 px-3 py-2 transition-colors cursor-pointer"
      >
        Sign In
      </button>

      <button
        type="button"
        data-modal-target="getstarted-modal"
        class="text-xs sm:text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 px-3 sm:px-4 py-2 rounded-xl transition-all shadow-sm hover:shadow-indigo-200 dark:hover:shadow-none shrink-0 cursor-pointer"
      >
        Get Started
      </button>

      <!-- Mobile & iPad Menu Toggle -->
      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden p-2 rounded-lg text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none"
        aria-label="Toggle Navigation Menu"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 px-4 pt-2 pb-4 space-y-2 text-sm font-medium text-gray-600 dark:text-gray-300"
  >
    <a
      href="/"
      class="block px-3 py-2 rounded-lg hover:bg-indigo-50 dark:hover:bg-gray-800 hover:text-indigo-600 dark:hover:text-indigo-400 nav-link"
      >Home</a
    >
    <a
      href="/articles"
      class="block px-3 py-2 rounded-lg hover:bg-indigo-50 dark:hover:bg-gray-800 hover:text-indigo-600 dark:hover:text-indigo-400 nav-link"
      >Articles</a
    >
    <a
      href="/features"
      class="block px-3 py-2 rounded-lg hover:bg-indigo-50 dark:hover:bg-gray-800 hover:text-indigo-600 dark:hover:text-indigo-400 nav-link"
      >Features</a
    >
    <a
      href="/about"
      class="block px-3 py-2 rounded-lg hover:bg-indigo-50 dark:hover:bg-gray-800 hover:text-indigo-600 dark:hover:text-indigo-400 nav-link"
      >About</a
    >
    <div
      class="pt-2 border-t border-gray-100 dark:border-gray-800 flex items-center gap-3"
    >
      <button
        type="button"
        data-modal-target="signin-modal"
        class="block px-3 py-2 text-gray-700 dark:text-gray-200 hover:text-indigo-600 dark:hover:text-indigo-400 font-semibold"
      >
        Sign In
      </button>
    </div>
  </div>
</header>

<main class="max-h-full" transition:animate="fade">
  <slot />
</main>

<footer
  class="bg-gray-900 dark:bg-gray-950 text-gray-400 border-t border-gray-800 py-12 transition-colors"
>
  <div
    class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 px-4 sm:px-6 lg:px-8 mb-12"
  >
    <!-- Resources Column -->
    <div class="flex flex-col">
      <h4 class="text-white font-semibold text-sm mb-4">Resources</h4>
      <ul class="flex flex-wrap gap-2">
        {
          uniqueTags.map((tag) => (
            <li>
              <a
                href={"/articles/tag/" + tag}
                class="hover:text-white transition-colors text-sm"
              >
                #{capitalize(tag)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Navigation Column -->
    <div>
      <h4 class="text-white font-semibold text-sm mb-4">Navigation</h4>
      <ul class="space-y-2.5 text-sm">
        <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
        <li>
          <a href="/articles" class="hover:text-white transition-colors"
            >Articles</a
          >
        </li>
        <li>
          <a href="/about" class="hover:text-white transition-colors"
            >About Us</a
          >
        </li>
      </ul>
    </div>

    <!-- Community Column -->
    <div>
      <h4 class="text-white font-semibold text-sm mb-4">Community</h4>
      <ul class="space-y-2.5 text-sm">
        <li>
          <a href="#" class="hover:text-white transition-colors">GitHub</a>
        </li>
        <li>
          <a href="#" class="hover:text-white transition-colors">Discord</a>
        </li>
        <li>
          <a href="#" class="hover:text-white transition-colors">Twitter</a>
        </li>
      </ul>
    </div>

    <!-- Legal Column -->
    <div>
      <h4 class="text-white font-semibold text-sm mb-4">Legal</h4>
      <ul class="space-y-2.5 text-sm">
        <li>
          <a href="#" class="hover:text-white transition-colors"
            >Privacy Policy</a
          >
        </li>
        <li>
          <a href="#" class="hover:text-white transition-colors"
            >Terms of Service</a
          >
        </li>
      </ul>
    </div>
  </div>

  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 border-t border-gray-800 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 gap-4"
  >
    <p>© 2026 TechPeople. All rights reserved.</p>
    <p>Built with Astro & Tailwind CSS.</p>
  </div>
</footer>

<!-- SIGN IN MODAL -->
<dialog
  id="signin-modal"
  class="fixed inset-0 m-auto backdrop:bg-gray-900/60 backdrop:backdrop-blur-sm bg-transparent p-4 focus:outline-none max-w-md w-full"
>
  <div
    class="bg-white dark:bg-gray-900 rounded-2xl shadow-2xl border border-gray-100 dark:border-gray-800 p-6 sm:p-8 relative transition-all"
  >
    <button
      type="button"
      class="close-modal absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path></svg
      >
    </button>

    <div class="text-center mb-6">
      <h2
        class="text-2xl font-bold text-gray-900 dark:text-white tracking-tight"
      >
        Welcome back
      </h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
        Please enter your details to sign in.
      </p>
    </div>

    <button
      type="button"
      class="w-full flex items-center justify-center gap-3 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-750 text-gray-700 dark:text-gray-200 font-semibold py-2.5 px-4 rounded-xl transition-all shadow-sm text-sm mb-4"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24">
        <path
          fill="#4285F4"
          d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
        ></path>
        <path
          fill="#34A853"
          d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
        ></path>
        <path
          fill="#FBBC05"
          d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
        ></path>
        <path
          fill="#EA4335"
          d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
        ></path>
      </svg>
      Sign in with Google
    </button>

    <div class="relative flex items-center justify-center my-6">
      <div class="border-t border-gray-200 dark:border-gray-800 w-full"></div>
      <span
        class="bg-white dark:bg-gray-900 px-3 text-xs text-gray-400 uppercase tracking-wider font-medium absolute"
        >or</span
      >
    </div>

    <form class="space-y-4" onsubmit="event.preventDefault();">
      <div>
        <label
          class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-1.5"
          >Email address</label
        >
        <input
          type="email"
          required
          placeholder="you@example.com"
          class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 text-sm transition-all"
        />
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label
            class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider"
            >Password</label
          >
          <a
            href="#"
            class="text-xs text-indigo-600 dark:text-indigo-400 hover:underline font-semibold"
            >Forgot password?</a
          >
        </div>
        <input
          type="password"
          required
          placeholder="••••••••"
          class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 text-sm transition-all"
        />
      </div>

      <button
        type="submit"
        class="w-full bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white font-semibold py-2.5 px-4 rounded-xl shadow-md transition-all text-sm mt-2"
      >
        Sign In
      </button>
    </form>

    <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-6">
      Don't have an account?
      <button
        type="button"
        data-modal-target="getstarted-modal"
        class="text-indigo-600 dark:text-indigo-400 font-semibold hover:underline"
        >Get started</button
      >
    </p>
  </div>
</dialog>

<!-- GET STARTED MODAL -->
<dialog
  id="getstarted-modal"
  class="fixed inset-0 m-auto backdrop:bg-gray-900/60 backdrop:backdrop-blur-sm bg-transparent p-4 focus:outline-none max-w-lg w-full"
>
  <div
    class="bg-white dark:bg-gray-900 rounded-2xl shadow-2xl border border-gray-100 dark:border-gray-800 p-6 sm:p-8 relative transition-all"
  >
    <button
      type="button"
      class="close-modal absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path></svg
      >
    </button>

    <div
      class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 text-xs font-semibold mb-4"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-indigo-600 dark:bg-indigo-400"
      ></span> Free 14-day trial • No credit card required
    </div>

    <div class="mb-6">
      <h2
        class="text-2xl font-bold text-gray-900 dark:text-white tracking-tight"
      >
        Create your account
      </h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
        Join thousands of developers building modern websites.
      </p>
    </div>

    <form class="space-y-4" onsubmit="event.preventDefault();">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label
            class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-1.5"
            >First Name</label
          >
          <input
            type="text"
            required
            placeholder="Jane"
            class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-all"
          />
        </div>
        <div>
          <label
            class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-1.5"
            >Last Name</label
          >
          <input
            type="text"
            required
            placeholder="Doe"
            class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-all"
          />
        </div>
      </div>

      <div>
        <label
          class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-1.5"
          >Work Email</label
        >
        <input
          type="email"
          required
          placeholder="jane@company.com"
          class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-all"
        />
      </div>

      <div>
        <label
          class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-1.5"
          >Create Password</label
        >
        <input
          type="password"
          required
          placeholder="Must be at least 8 characters"
          class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-all"
        />
      </div>

      <div class="flex items-start gap-2.5 pt-1">
        <input
          type="checkbox"
          required
          id="terms"
          class="mt-1 rounded border-gray-300 dark:border-gray-700 text-indigo-600 focus:ring-indigo-500"
        />
        <label
          for="terms"
          class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed"
        >
          I agree to the <a
            href="#"
            class="text-indigo-600 dark:text-indigo-400 hover:underline"
            >Terms of Service</a
          > and <a
            href="#"
            class="text-indigo-600 dark:text-indigo-400 hover:underline"
            >Privacy Policy</a
          >.
        </label>
      </div>

      <button
        type="submit"
        class="w-full bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white font-semibold py-3 px-4 rounded-xl shadow-md transition-all text-sm mt-2"
      >
        Create Free Account →
      </button>
    </form>

    <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-6">
      Already have an account?
      <button
        type="button"
        data-modal-target="signin-modal"
        class="text-indigo-600 dark:text-indigo-400 font-semibold hover:underline"
        >Sign in</button
      >
    </p>
  </div>
</dialog>

<script>
  // Dynamic client navigation, theme switcher, and modal interactions
  document.addEventListener("astro:page-load", () => {
    // 1. Mobile Menu Toggle
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    if (menuToggle && mobileMenu) {
      menuToggle.onclick = () => mobileMenu.classList.toggle("hidden");
    }

    // 2. Dynamic Active Link Highlight
    const pathname = window.location.pathname;
    const navLinks = document.querySelectorAll(".nav-link");
    navLinks.forEach((link) => {
      const href = link.getAttribute("href");
      const isActive =
        href === "/" ? pathname === "/" : href && pathname.startsWith(href);
      if (isActive) {
        if (link.classList.contains("block")) {
          link.className =
            "block px-3 py-2 rounded-lg bg-indigo-50 dark:bg-gray-800 text-indigo-600 dark:text-indigo-400 font-semibold nav-link";
        } else {
          link.className =
            "text-indigo-600 dark:text-indigo-400 font-semibold nav-link";
        }
      } else {
        if (link.classList.contains("block")) {
          link.className =
            "block px-3 py-2 rounded-lg hover:bg-indigo-50 dark:hover:bg-gray-800 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors nav-link";
        } else {
          link.className =
            "hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors nav-link";
        }
      }
    });

    // 3. Dark Mode Toggle
    const themeToggles = document.querySelectorAll(".theme-toggle");
    themeToggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
    });

    // 4. Modal Dialog Logic
    const modals = document.querySelectorAll("dialog");
    const modalTriggers = document.querySelectorAll("[data-modal-target]");
    const closeBtns = document.querySelectorAll(".close-modal");

    const closeModal = (modal: HTMLDialogElement) => {
      modal.close();
      document.body.style.overflow = "";
    };

    modalTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const targetId = trigger.getAttribute("data-modal-target");
        if (!targetId) return;

        // Close open modals before launching targeted modal
        modals.forEach((m) => m.open && closeModal(m as HTMLDialogElement));

        const targetModal = document.getElementById(
          targetId,
        ) as HTMLDialogElement;
        if (targetModal) {
          targetModal.showModal();
          document.body.style.overflow = "hidden";
        }
      });
    });

    closeBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const modal = btn.closest("dialog") as HTMLDialogElement;
        if (modal) closeModal(modal);
      });
    });

    // Dismiss modal on backdrop click
    modals.forEach((modal) => {
      modal.addEventListener("click", (e) => {
        const dialogDimensions = modal.getBoundingClientRect();
        if (
          e.clientX < dialogDimensions.left ||
          e.clientX > dialogDimensions.right ||
          e.clientY < dialogDimensions.top ||
          e.clientY > dialogDimensions.bottom
        ) {
          closeModal(modal);
        }
      });
    });
  });
</script>

<style is:global>
  ::view-transition-old(root) {
    animation-duration: 400ms;
  }
  ::view-transition-new(root) {
    animation-duration: 500ms;
    animation-delay: 200ms;
  }
</style>
