---
import "/src/styles/global.css";

interface Props {
  title?: string;
}

const { title = "Flowbite Astro App" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body
    class="bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100 flex flex-col min-h-screen font-sans antialiased transition-colors duration-200"
  >
    <slot />
  </body>
</html>
